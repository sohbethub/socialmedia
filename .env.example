# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. (.env depoya girmez)

# PostgreSQL bağlantısı (ücretsiz: neon.tech — yerel geliştirmede de aynı
# Neon veritabanını kullanabilirsiniz)
DATABASE_URL="postgresql://kullanici:sifre@host/veritabani?sslmode=require"

# /api/cron rotasını koruyan gizli anahtar
CRON_SECRET=

# Faz 2 — YouTube (Google Cloud Console > OAuth 2.0 istemcisi)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Faz 3 — Instagram (Meta for Developers uygulaması)
META_APP_ID=
META_APP_SECRET=

# Faz 4 — AI analizleri ve büyüme önerileri (console.anthropic.com'dan alınır)
ANTHROPIC_API_KEY=
